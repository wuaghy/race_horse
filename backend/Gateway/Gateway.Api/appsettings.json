{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" },
        "AuthorizationPolicy": "anonymous"
      },
      "identity-me": {
        "ClusterId": "identity",
        "Order": -1,
        "Match": { "Path": "/api/v1/auth/me" },
        "AuthorizationPolicy": "authenticated"
      },
      "booking-customers": {
        "ClusterId": "booking",
        "Match": { "Path": "/api/v1/customers/{**catch-all}" },
        "AuthorizationPolicy": "authenticated"
      },
      "booking-horses": {
        "ClusterId": "booking",
        "Match": { "Path": "/api/v1/horses/{**catch-all}" },
        "AuthorizationPolicy": "authenticated"
      },
      "booking-requests": {
        "ClusterId": "booking",
        "Match": { "Path": "/api/v1/transport-requests/{**catch-all}" },
        "AuthorizationPolicy": "authenticated"
      },
      "booking-manager": {
        "ClusterId": "booking",
        "Match": { "Path": "/api/v1/manager/transport-requests/{**catch-all}" },
        "AuthorizationPolicy": "authenticated"
      },
      "compliance": {
        "ClusterId": "compliance",
        "Match": { "Path": "/api/v1/compliance/{**catch-all}" },
        "AuthorizationPolicy": "authenticated"
      },
      "handovers": {
        "ClusterId": "handover",
        "Match": { "Path": "/api/v1/handovers/{**catch-all}" },
        "AuthorizationPolicy": "authenticated"
      },
      "planning-countries": {
        "ClusterId": "planning", "Order": 100,
        "Match": { "Path": "/api/v1/countries/{**catch-all}" },
        "AuthorizationPolicy": "authenticated"
      },
      "planning-locations": {
        "ClusterId": "planning", "Order": 100,
        "Match": { "Path": "/api/v1/locations/{**catch-all}" },
        "AuthorizationPolicy": "authenticated"
      },
      "planning-vehicles": {
        "ClusterId": "planning", "Order": 100,
        "Match": { "Path": "/api/v1/vehicles/{**catch-all}" },
        "AuthorizationPolicy": "authenticated"
      },
      "planning-stalls": {
        "ClusterId": "planning", "Order": 100,
        "Match": { "Path": "/api/v1/stalls/{**catch-all}" },
        "AuthorizationPolicy": "authenticated"
      },
      "planning-airlines": {
        "ClusterId": "planning", "Order": 100,
        "Match": { "Path": "/api/v1/airlines/{**catch-all}" },
        "AuthorizationPolicy": "authenticated"
      },
      "planning-flight-bookings": {
        "ClusterId": "planning", "Order": 100,
        "Match": { "Path": "/api/v1/flight-bookings/{**catch-all}" },
        "AuthorizationPolicy": "authenticated"
      },
      "planning-availability": {
        "ClusterId": "planning", "Order": 100,
        "Match": { "Path": "/api/v1/availability/{**catch-all}" },
        "AuthorizationPolicy": "authenticated"
      },
      "planning-trips": {
        "ClusterId": "planning", "Order": 100,
        "Match": { "Path": "/api/v1/trips/{**catch-all}" },
        "AuthorizationPolicy": "authenticated"
      },
      "planning-route-plans": {
        "ClusterId": "planning", "Order": 100,
        "Match": { "Path": "/api/v1/route-plans/{**catch-all}" },
        "AuthorizationPolicy": "authenticated"
      },
      "planning-route-plan-versions": {
        "ClusterId": "planning", "Order": 100,
        "Match": { "Path": "/api/v1/route-plan-versions/{**catch-all}" },
        "AuthorizationPolicy": "authenticated"
      },
      "planning-route-legs": {
        "ClusterId": "planning", "Order": 100,
        "Match": { "Path": "/api/v1/route-legs/{**catch-all}" },
        "AuthorizationPolicy": "authenticated"
      },
      "planning-checkpoints": {
        "ClusterId": "planning", "Order": 100,
        "Match": { "Path": "/api/v1/checkpoints/{**catch-all}" },
        "AuthorizationPolicy": "authenticated"
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity-api": { "Address": "http://localhost:5059/" }
        }
      },
      "booking": {
        "Destinations": {
          "booking-api": { "Address": "http://localhost:5194/" }
        }
      },
      "compliance": {
        "Destinations": {
          "compliance-api": { "Address": "http://localhost:5277/" }
        }
      },
      "handover": {
        "Destinations": {
          "handover-api": { "Address": "http://localhost:5144/" }
        }
      },
      "planning": {
        "Destinations": {
          "planning-api": { "Address": "http://localhost:5022/" }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
