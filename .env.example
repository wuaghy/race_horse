# ========================================================
# Cross-Border Racehorse Transport System — Environment Config
# ========================================================
# Local development only. Do not deploy these sample values.
# Copy to .env and replace JWT_SIGNING_KEY with a fresh random key before startup.

# SQL Server Configuration
MSSQL_SA_PASSWORD=YourStrong@Password2026!
MSSQL_PORT=1433

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# MinIO (S3-compatible Object Storage) Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# JWT Settings (Compose reads JWT_SIGNING_KEY; never use a committed key)
JWT_SIGNING_KEY=REPLACE_WITH_RANDOM_BASE64_KEY_AT_LEAST_32_BYTES
JWT_ISSUER=racehorse-identity
JWT_AUDIENCE=racehorse-api
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# Local testing
SEED_DEMO_DATA=false
DEMO_DATA_PASSWORD=HorseDev2026!
GATEWAY_PORT=8080
IDENTITY_PORT=8081
BOOKING_PORT=8082
