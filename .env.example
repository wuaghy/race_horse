# Copy this file to .env for local Docker development.
# Never commit the real .env file or reuse these development values in production.

# Required: replace with a random value of at least 32 bytes.
JWT_SIGNING_KEY=
JWT_ISSUER=racehorse-identity
JWT_AUDIENCE=racehorse-api
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# Local development infrastructure credentials.
MSSQL_SA_PASSWORD=
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Optional seeded demo accounts. Change the password before enabling.
SEED_DEMO_DATA=false
DEMO_DATA_PASSWORD=

# Host ports.
GATEWAY_PORT=8080
IDENTITY_PORT=8081
BOOKING_PORT=8082
COMPLIANCE_PORT=8083
TRACKING_PORT=8084
HANDOVER_PORT=8085
INCIDENT_PORT=8086
NOTIFICATION_PORT=8087

# SMTP email delivery (optional; leave disabled until credentials are configured)
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=EquiRoute
EMAIL_ENABLE_SSL=true

# PayOS payment gateway. Keep credentials out of source control.
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_WEBHOOK_URL=http://localhost:8082/api/v1/payments/payos/webhook
PAYOS_SUCCESS_URL=http://localhost:5173/payment/success
PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel
PORTAL_BASE_URL=http://localhost:5173
MSSQL_PORT=1433
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
